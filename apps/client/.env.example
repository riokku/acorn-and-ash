# Point the client at a different world server. Leave it unset to use the same
# origin the page was served from, which is what happens in production.
#
# Play against the deployed staging world:
# VITE_GAME_SERVER_URL=https://acorn-ash-web-staging.workers.dev

# Which world to join. There is only one in Phase 0.
# VITE_WORLD_ID=home-clearing
