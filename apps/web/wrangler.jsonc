{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acorn-ash-web",
  "main": "src/index.ts",
  // Held at a date the bundled test runtime also supports, so tests run on the
  // same runtime as production. Raise this and the game server's together.
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  // The built game client. Static assets are limited to 25 MiB per file, so
  // large models and textures belong in R2 with content-hashed names.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the asset router would answer /api/* with index.html.
    "run_worker_first": ["/api/*"],
  },

  // This Worker does not implement the World class, it borrows it from the game
  // server. That is what lets pull requests get a preview URL. See
  // docs/decisions/0001-two-workers-for-preview-urls.md.
  "durable_objects": {
    "bindings": [
      { "name": "WORLD", "class_name": "World", "script_name": "acorn-ash-game-server" },
    ],
  },

  "env": {
    "staging": {
      "name": "acorn-ash-web-staging",
      "observability": { "enabled": true },
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORLD",
            "class_name": "World",
            "script_name": "acorn-ash-game-server-staging",
          },
        ],
      },
    },
    "production": {
      "name": "acorn-ash-web-production",
      "observability": { "enabled": true },
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORLD",
            "class_name": "World",
            "script_name": "acorn-ash-game-server-production",
          },
        ],
      },
    },
  },
}
