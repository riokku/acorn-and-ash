{
  "name": "@acorn/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker that serves the game client and routes realtime traffic to the World Durable Object.",
  "scripts": {
    "build": "pnpm --filter @acorn/client build",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@acorn/shared": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@acorn/client": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
