{
  "name": "@acorn/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker that serves the game client and routes realtime traffic to the World Durable Object.",
  "scripts": {
    "build": "pnpm --filter @acorn/client build",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "pnpm db:migrate:local && wrangler dev -c wrangler.jsonc -c ../game-server/wrangler.jsonc",
    "pretest": "pnpm --filter @acorn/client build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate --name accounts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@acorn/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@acorn/client": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
