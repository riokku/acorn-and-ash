{
  "name": "acorn-and-ash",
  "version": "0.0.0",
  "private": true,
  "description": "A cozy third-person survival game that runs in the browser.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @acorn/client dev",
    "dev:server": "pnpm --filter @acorn/game-server dev",
    "dev:web": "pnpm --filter @acorn/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check:assets": "node tools/check-asset-licenses.mjs",
    "bench:tick": "pnpm --filter @acorn/tools bench:tick",
    "loadtest": "pnpm --filter @acorn/tools loadtest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:assets && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
